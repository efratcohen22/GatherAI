# Copy to .env. Never commit real values.
APP_ENV=development
DATABASE_URL=sqlite:///./gatherai.db
AUTH_MODE=local
# At least 32 random characters. scripts/setup.ps1 generates one in .env.
LOCAL_JWT_SECRET=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Live model calls per organization per rolling 24 hours (0 disables live AI)
AI_DAILY_REQUEST_LIMIT=300
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
